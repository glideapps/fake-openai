#!/usr/bin/env bash
set -euo pipefail

if ! node -e '
  const match = /^(\d+)\.(\d+)\.(\d+)$/.exec(process.argv[1]);
  if (!match) process.exit(1);
  const [, major, minor, patch] = match.map(Number);
  process.exit(major > 11 || major === 11 && (minor > 19 || minor === 19 && patch >= 1) ? 0 : 1);
' "$(npm --version)"; then
  npm install --global npm@11.19.1 --ignore-scripts --no-audit --no-fund
fi

npm ci
